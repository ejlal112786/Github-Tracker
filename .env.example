# =====================================================================
# GitHub Tracker — environment template (NO real values in this file!)
# Copy to .env.local for local development. On Vercel, configure these
# in Project Settings -> Environment Variables instead of committing.
# Phase 1 runs with NONE of these set — the preview UI needs no secrets.
# =====================================================================

# --- Phase 2+: Supabase (database + authentication) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Phase 2+: GitHub OAuth app (https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Canonical app URL used for redirects (e.g. https://your-app.vercel.app) ---
NEXT_PUBLIC_APP_URL=
